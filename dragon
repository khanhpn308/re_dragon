#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ACTION="${1:-status}"
SESSION="re-dragon-quota-watchdog"
BOT_SESSION="re-dragon-telegram"
BOT_CFG="$HOME/.config/re-dragon/telegram.json"
BOT_PY="$ROOT/.venv-telegram/bin/python"
BOT_LOG="$ROOT/.re_harness/telegram.log"
cd "$ROOT"

bot_logs() {
  if [[ -f "$BOT_LOG" ]]; then
    echo "--- Durable Telegram log (redacted): $BOT_LOG ---"
    tail -n 80 "$BOT_LOG" | sed -E 's/[0-9]{6,}:[A-Za-z0-9_-]{25,}/[REDACTED_BOT_TOKEN]/g'
  else
    echo "No Telegram log yet: $BOT_LOG"
  fi
}

bot_start() {
  command -v tmux >/dev/null || { echo "Install tmux first" >&2; return 1; }
  [[ -f "$BOT_CFG" ]] || { echo "Configure once: ./dragon telegram setup" >&2; return 1; }
  [[ -x "$BOT_PY" ]] || {
    echo "Install Telegram library once:" >&2
    echo "python3 -m venv .venv-telegram && .venv-telegram/bin/pip install -e '.[telegram]'" >&2
    return 1
  }
  if tmux has-session -t "$BOT_SESSION" 2>/dev/null; then
    echo "Telegram bot already running"
    return 0
  fi
  mkdir -p "$ROOT/.re_harness"
  chmod 700 "$ROOT/.re_harness"
  cmd=(bash "$ROOT/scripts/telegram-supervised.sh" "$BOT_LOG" "$BOT_PY"
       -m re_harness.telegram_bridge run --workspace "$ROOT")
  printf -v quoted '%q ' "${cmd[@]}"
  tmux new-session -d -s "$BOT_SESSION" -c "$ROOT" "$quoted"
  echo "Telegram process launched in tmux; API readiness is not yet verified."
  echo "Persistent diagnostic log: $BOT_LOG"
  if ! tmux has-session -t "$BOT_SESSION" 2>/dev/null; then
    echo "Telegram process exited immediately; see ./dragon telegram logs" >&2
    return 1
  fi
}
bot_stop() {
  if command -v tmux >/dev/null && tmux has-session -t "$BOT_SESSION" 2>/dev/null; then
    tmux kill-session -t "$BOT_SESSION"
  fi
  echo "Telegram bot stopped."
}
bot_status() {
  if command -v tmux >/dev/null && tmux has-session -t "$BOT_SESSION" 2>/dev/null; then
    echo "Telegram bot: RUNNING"
  else
    echo "Telegram bot: STOPPED"
    if [[ -f "$BOT_LOG" ]]; then echo "See: ./dragon telegram logs"; fi
  fi
}

case "$ACTION" in
  start)
    command -v agy >/dev/null || { echo "Missing authenticated agy CLI" >&2; exit 1; }
    command -v tmux >/dev/null || { echo "Install tmux: sudo apt install tmux" >&2; exit 1; }
    if ! tmux has-session -t "$SESSION" 2>/dev/null; then
      args=(--workspace "$ROOT")
      if [[ -n "${RE_DRAGON_HARNESS_STATE_DIR:-}" ]]; then
        args+=(--state-dir "$RE_DRAGON_HARNESS_STATE_DIR")
      fi
      if [[ -n "${2:-}" && "$2" != --* ]]; then
        args+=(--project-id "$2")
      elif [[ "$#" -gt 1 ]]; then
        shift
        args+=("$@")
      fi
      python3 -m re_harness.easy_start "${args[@]}"
      bash scripts/quota-watchdog.sh start
    else
      echo "Watchdog already running"
    fi
    if [[ -f "$BOT_CFG" ]]; then
      bot_start || echo "Telegram not started. Agent Watchdog remains running." >&2
    fi
    ;;
  status)
    bash scripts/quota-watchdog.sh status
    bot_status
    ;;
  drain)
    bash scripts/quota-watchdog.sh drain "${2:-120}"
    ;;
  stop)
    bash scripts/quota-watchdog.sh stop "${2:-}"
    bot_stop
    ;;
  logs)
    bash scripts/quota-watchdog.sh logs
    bot_logs
    ;;
  pause)
    python3 -m re_harness.quota_watchdog pause --workspace "$ROOT"
    ;;
  resume)
    bash scripts/quota-watchdog.sh reset
    "$0" start
    ;;
  supervisor)
    CMD="${2:-status}"
    case "$CMD" in
      status) python3 -m re_harness.supervisor status --workspace "$ROOT" ;;
      generate) python3 -m re_harness.supervisor generate-config --workspace "$ROOT" ;;
      run) python3 -m re_harness.supervisor run --workspace "$ROOT" ;;
      *) echo "Usage: ./dragon supervisor {status|generate|run}" >&2; exit 2 ;;
    esac
    ;;
  telegram)
    CMD="${2:-status}"
    case "$CMD" in
      setup) python3 -m re_harness.telegram_bridge setup ;;
      doctor)
        if [[ ! -x "$BOT_PY" ]]; then
          echo "Install Telegram dependency first: .venv-telegram/bin/pip install -e '.[telegram]'" >&2
          exit 2
        fi
        "$BOT_PY" -m re_harness.telegram_bridge doctor --workspace "$ROOT"
        ;;
      start) bot_start ;;
      stop) bot_stop ;;
      status) bot_status ;;
      logs) bot_logs ;;
      *) echo "Usage: ./dragon telegram {setup|doctor|start|stop|status|logs}" >&2; exit 2 ;;
    esac
    ;;
  *)
    echo "Usage: ./dragon {start|status|logs|drain [TIMEOUT]|stop [--force]|pause|resume|supervisor|telegram}" >&2
    exit 2
    ;;
esac
